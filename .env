# ============================================
# FRONTEND CONFIGURATION
# ============================================
VITE_API_URL=http://localhost:8080
VITE_APP_NAME=Gestion de Proveedores ERP
VITE_ENABLE_SWAGGER=true
VITE_DEBUG_MODE=true

# ============================================
# DATABASE CONFIGURATION
# ============================================
POSTGRES_DB=gestion_proveedores_dev
POSTGRES_USER=dev_user
POSTGRES_PASSWORD=dev_password_local_only
DB_HOST=postgres
DB_PORT=5432

# ============================================
# JWT CONFIGURATION
# ============================================
# Development key (NOT FOR PRODUCTION)
JWT_SECRET=ZGV2X2NvZGVfand0X1NlY3JldF9LZXlfVGVzdGluZ19Pbmx5XzIwMjY=
JWT_EXPIRATION=86400000

# ============================================
# SPRING BOOT CONFIGURATION
# ============================================
ENVIRONMENT=dev
SERVER_PORT=8080
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_FLYWAY_ENABLED=true
DB_POOL_SIZE=10

# ============================================
# CORS CONFIGURATION
# ============================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_MAX_AGE=3600
