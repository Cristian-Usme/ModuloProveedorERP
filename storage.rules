rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function canManageFiles() {
      return signedIn() && (request.auth.token.role in ['Super Admin', 'Admin', 'Finanzas', 'Ventas', 'Bodega']);
    }

    match /users/{userId}/{fileName} {
      allow read, write: if signedIn() && (request.auth.uid == userId || request.auth.token.role in ['Super Admin', 'Admin']);
    }

    match /companies/{companyId}/{fileName} {
      allow read: if signedIn();
      allow write: if canManageFiles();
    }

    match /products/{productId}/{fileName} {
      allow read: if signedIn();
      allow write: if canManageFiles();
    }

    match /documents/{documentType}/{fileName} {
      allow read: if signedIn();
      allow write: if canManageFiles();
    }

    match /reports/{reportId}/{fileName} {
      allow read: if signedIn();
      allow write: if request.auth.token.role in ['Super Admin', 'Admin', 'Finanzas'];
    }

    match /{allPaths=**} {
      allow read: if signedIn();
      allow write: if request.auth.token.role == 'Super Admin';
    }
  }
}